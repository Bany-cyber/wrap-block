{
  "name": "wrap-block",
  "displayName": "wrap-block",
  "description": "Wrap selection into if/else/for/while blocks",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
"activationEvents": [
    "onCommand:wrapBlock.wrapWithBlock"
],
  "main": "./out/extension.js",
"contributes": {
    "commands": [
        {
            "command": "wrapBlock.wrapWithBlock",
            "title": "Обернуть код в блок"
        }
    ],
    "keybindings": [
        {
            "command": "wrapBlock.wrapWithBlock",
            "key": "ctrl+alt+w",
            "when": "editorTextFocus"
        }
    ]
},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.138.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
